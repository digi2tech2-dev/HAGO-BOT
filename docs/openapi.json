      "NobilityRechargeRequest": { "type": "object", "additionalProperties": false, "required": ["agentPhone", "targetId", "nobilityType"], "properties": { "agentPhone": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 }, "nobilityType": { "type": "integer", "minimum": 1, "maximum": 4 } } },
