      "V2SendOtpRequest": { "type": "object", "additionalProperties": false, "required": ["phone", "countryCode", "deviceId"], "properties": { "phone": { "type": "string", "pattern": "^\\+?\\d{8,18}$", "writeOnly": true }, "countryCode": { "type": "string", "pattern": "^\\d{1,4}$" }, "deviceId": { "type": "string", "minLength": 8, "maxLength": 256, "writeOnly": true }, "country": { "type": "string", "pattern": "^[A-Z]{2}$" }, "language": { "type": "string" } } },
      "V2VerifyOtpRequest": { "type": "object", "additionalProperties": false, "required": ["otp", "deviceId"], "properties": { "otp": { "type": "string", "writeOnly": true }, "deviceId": { "type": "string", "writeOnly": true } } },
      "V2ChallengeResponse": { "type": "object", "required": ["status", "challengeId", "expiresAt"], "properties": { "status": { "type": "string", "enum": ["OTP_SENT"] }, "challengeId": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" } } },
      "V2ConnectionResponse": { "type": "object", "required": ["status", "connection"], "properties": { "status": { "type": "string", "enum": ["SUCCESS"] }, "connection": { "type": "object", "properties": { "connectionId": { "type": "string" }, "status": { "type": "string" } } } } },
