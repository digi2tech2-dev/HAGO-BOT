{
  "openapi": "3.0.3",
  "info": {
    "title": "Hago Integration Adapter API",
    "version": "1.0.0",
    "description": "Backend-only Hago adapter. Every /api operation is trusted server-to-server. The contract contains no credentials, account identifiers, OTPs, sessions, or live financial values."
  },
  "tags": [
    { "name": "Health" },
    { "name": "Authentication" },
    { "name": "Session & Identity" },
    { "name": "Read-only Diagnostics" },
    { "name": "Wallet & History" },
    { "name": "Transactions" },
    { "name": "Previews" },
    { "name": "Controlled Mutations" },
    { "name": "Nobility" },
    { "name": "V2 Connections" }
  ],
  "paths": {
    "/api/v2/login-challenges": {
      "post": { "tags": ["V2 Connections", "Authentication"], "summary": "Send a tenant-owned OTP challenge", "security": [{ "ClientApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/V2SendOtp" }, "responses": { "202": { "$ref": "#/components/responses/V2Challenge" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v2/login-challenges/{challengeId}/verify": {
      "post": { "tags": ["V2 Connections", "Authentication"], "summary": "Claim a challenge once and establish an encrypted Connection", "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }], "requestBody": { "$ref": "#/components/requestBodies/V2VerifyOtp" }, "responses": { "200": { "$ref": "#/components/responses/V2Connection" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v2/connections/{connectionId}/wallet-balance": {
      "post": { "tags": ["V2 Connections", "Wallet & History"], "summary": "Read wallet through a tenant-owned Connection", "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "responses": { "200": { "$ref": "#/components/responses/WalletBalance" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v2/connections/{connectionId}/session/validate": { "post": { "tags": ["V2 Connections"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "responses": { "200": { "$ref": "#/components/responses/SessionValidation" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v2/connections/{connectionId}/verify-id": { "post": { "tags": ["V2 Connections"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "requestBody": { "$ref": "#/components/requestBodies/V2Target" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v2/connections/{connectionId}/agent-profile": { "post": { "tags": ["V2 Connections"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v2/connections/{connectionId}/account-history": { "post": { "tags": ["V2 Connections"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "requestBody": { "$ref": "#/components/requestBodies/V2History" }, "responses": { "200": { "$ref": "#/components/responses/AccountHistory" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v2/connections/{connectionId}/transfer-readiness": { "post": { "tags": ["V2 Connections"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "responses": { "200": { "$ref": "#/components/responses/TransferReadiness" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v2/connections/{connectionId}/nobility-readiness": { "post": { "tags": ["V2 Connections", "Nobility"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "requestBody": { "$ref": "#/components/requestBodies/V2Target" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v2/connections/{connectionId}/nobility-purchase-readiness": { "post": { "tags": ["V2 Connections", "Nobility"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "requestBody": { "$ref": "#/components/requestBodies/V2Nobility" }, "responses": { "200": { "$ref": "#/components/responses/NobilityPurchaseReadiness" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v2/connections/{connectionId}/previews/diamond": { "post": { "tags": ["V2 Connections", "Previews"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "requestBody": { "$ref": "#/components/requestBodies/V2Amount" }, "responses": { "200": { "$ref": "#/components/responses/Preview" } } } },
    "/api/v2/connections/{connectionId}/previews/crystal": { "post": { "tags": ["V2 Connections", "Previews"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "requestBody": { "$ref": "#/components/requestBodies/V2Amount" }, "responses": { "200": { "$ref": "#/components/responses/Preview" } } } },
    "/api/v2/connections/{connectionId}/previews/nobility": { "post": { "tags": ["V2 Connections", "Previews", "Nobility"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "requestBody": { "$ref": "#/components/requestBodies/V2Nobility" }, "responses": { "200": { "$ref": "#/components/responses/Preview" } } } },
    "/api/v2/connections/{connectionId}/auto-recharge/diamond": { "post": { "tags": ["V2 Connections", "Controlled Mutations"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/ControlledMutation" }], "requestBody": { "$ref": "#/components/requestBodies/V2AmountTarget" }, "responses": { "200": { "$ref": "#/components/responses/Transaction" } } } },
    "/api/v2/connections/{connectionId}/auto-recharge/crystal": { "post": { "tags": ["V2 Connections", "Controlled Mutations"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/ControlledMutation" }], "requestBody": { "$ref": "#/components/requestBodies/V2AmountTarget" }, "responses": { "200": { "$ref": "#/components/responses/Transaction" } } } },
    "/api/v2/connections/{connectionId}/auto-recharge/nobility": { "post": { "tags": ["V2 Connections", "Nobility"], "description": "No price, pack, buy type, or buyer UID is accepted.", "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/V2Nobility" }, "responses": { "200": { "$ref": "#/components/responses/Transaction" } } } },
    "/api/v2/connections/{connectionId}/transactions": { "post": { "tags": ["V2 Connections", "Transactions"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "responses": { "200": { "$ref": "#/components/responses/TransactionList" } } } },
    "/api/v2/connections/{connectionId}/transactions/reconcile": { "post": { "tags": ["V2 Connections", "Transactions"], "security": [{ "ClientApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ConnectionId" }], "requestBody": { "$ref": "#/components/requestBodies/V2Reconcile" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/health": {
      "get": { "tags": ["Health"], "summary": "Process liveness", "security": [], "responses": { "200": { "$ref": "#/components/responses/Health" } } }
    },
    "/ready": {
      "get": { "tags": ["Health"], "summary": "Local dependency readiness", "security": [], "responses": { "200": { "$ref": "#/components/responses/Ready" }, "503": { "$ref": "#/components/responses/Ready" } } }
    },
    "/api/auth/send-otp": {
      "post": { "tags": ["Authentication"], "summary": "Request an OTP", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/SendOtp" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/auth/verify-otp": {
      "post": { "tags": ["Authentication"], "summary": "Verify an OTP and establish a session", "description": "The trusted website/backend forwards a stable browser deviceId. Cookies and session material are never returned.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/VerifyOtp" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/session/validate": {
      "post": { "tags": ["Session & Identity"], "summary": "Validate a stored Hago session", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/AgentPhone" }, "responses": { "200": { "$ref": "#/components/responses/SessionValidation" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/verify-id": {
      "post": { "tags": ["Session & Identity"], "summary": "Resolve a VID to an internal UID", "description": "The VID is never treated as the UID.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Target" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/agent-profile": {
      "post": { "tags": ["Session & Identity"], "summary": "Read the authenticated agent profile", "description": "Uses authenticated hagouid, not UAAS h_open_id.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/AgentPhone" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/transfer-readiness": {
      "post": { "tags": ["Read-only Diagnostics"], "summary": "Read transfer prerequisites", "description": "Read-only. Does not accept a transaction password or send a transfer.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/TransferReadiness" }, "responses": { "200": { "$ref": "#/components/responses/TransferReadiness" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/nobility-readiness": {
      "post": { "tags": ["Nobility", "Read-only Diagnostics"], "summary": "Read Noble configuration and target state", "description": "Read-only. Never calls BuyNobleByAgency.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/NobilityReadiness" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/nobility-purchase-readiness": {
      "post": { "tags": ["Nobility", "Read-only Diagnostics"], "summary": "Read current Nobility purchase eligibility", "description": "READ-ONLY. Creates no transaction intent and implies no authorization to purchase.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/NobilityPurchaseReadiness" }, "responses": { "200": { "$ref": "#/components/responses/NobilityPurchaseReadiness" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/wallet-balance": {
      "post": { "tags": ["Wallet & History"], "summary": "Read normalized wallet balances", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/AgentPhone" }, "responses": { "200": { "$ref": "#/components/responses/WalletBalance" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/account-history": {
      "post": { "tags": ["Wallet & History"], "summary": "Read bounded account history", "description": "Read-only and not an authoritative settlement ledger.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/AccountHistory" }, "responses": { "200": { "$ref": "#/components/responses/AccountHistory" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/transactions": {
      "post": { "tags": ["Transactions"], "summary": "List local transaction attempts", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/AgentPhone" }, "responses": { "200": { "$ref": "#/components/responses/TransactionList" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/transactions/reconcile": {
      "post": { "tags": ["Transactions"], "summary": "Read-only reconciliation aid", "description": "Does not retry, send a mutation, or automatically change outcome status.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Reconcile" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/auto-recharge/diamond/preview": {
      "post": { "tags": ["Previews"], "summary": "Preview Diamond request structure locally", "description": "No Hago request, session, wallet, or VID lookup.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/DiamondRecharge" }, "responses": { "200": { "$ref": "#/components/responses/Preview" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/auto-recharge/crystal/preview": {
      "post": { "tags": ["Previews"], "summary": "Preview Crystal request structure locally", "description": "No Hago request, session, wallet, or VID lookup.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/CrystalRecharge" }, "responses": { "200": { "$ref": "#/components/responses/Preview" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/auto-recharge/nobility/preview": {
      "post": { "tags": ["Previews", "Nobility"], "summary": "Preview Nobility payload metadata locally", "description": "Structural only; never reads configuration, session, or Hago.", "security": [{ "ApiKeyAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/NobilityPreview" }, "responses": { "200": { "$ref": "#/components/responses/Preview" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/auto-recharge/diamond": {
      "post": { "tags": ["Controlled Mutations"], "summary": "Send one guarded Diamond transfer", "description": "CONTROLLED FINANCIAL MUTATION. Requires both Diamond/Crystal environment guards, a bounded ceiling, and X-Controlled-Mutation. One authorized controlled request is LIVE-VERIFIED once.", "security": [{ "ApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/ControlledMutation" }], "requestBody": { "$ref": "#/components/requestBodies/DiamondRecharge" }, "responses": { "200": { "$ref": "#/components/responses/Transaction" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" }, "504": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/auto-recharge/crystal": {
      "post": { "tags": ["Controlled Mutations"], "summary": "Send one guarded Crystal transfer", "description": "CONTROLLED FINANCIAL MUTATION. Requires both Diamond/Crystal environment guards, a bounded ceiling, and X-Controlled-Mutation. One authorized controlled request returned code 1 and the wallet balance decreased by exactly the sent amount.", "security": [{ "ApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/ControlledMutation" }], "requestBody": { "$ref": "#/components/requestBodies/CrystalRecharge" }, "responses": { "200": { "$ref": "#/components/responses/Transaction" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" }, "504": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/bot/auto-recharge/nobility": {
      "post": { "tags": ["Nobility"], "summary": "Purchase or renew Nobility", "description": "FINANCIAL MUTATION. Requires Idempotency-Key and HAGO_NOBILITY_ENABLED=true. Price, pack, buy type, and buyer UID are refreshed and derived internally. X-Controlled-Mutation is not used. First live financial outcome is pending.", "security": [{ "ApiKeyAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/NobilityRecharge" }, "responses": { "200": { "$ref": "#/components/responses/Transaction" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" }, "504": { "$ref": "#/components/responses/Error" } } }
    }
  },
  "components": {
    "securitySchemes": { "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-internal-api-key" }, "ClientApiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-client-api-key" } },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 128 }, "description": "Stable trusted-backend financial order key." },
      "ControlledMutation": { "name": "X-Controlled-Mutation", "in": "header", "required": true, "schema": { "type": "string", "enum": ["true"] }, "description": "Explicit controlled Diamond/Crystal request signal." },
      "ChallengeId": { "name": "challengeId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^chl_[A-Za-z0-9_-]{22}$" } },
      "ConnectionId": { "name": "connectionId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^con_[A-Za-z0-9_-]{22}$" } }
    },
    "requestBodies": {
      "SendOtp": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendOtpRequest" } } } },
      "VerifyOtp": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyOtpRequest" } } } },
      "AgentPhone": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentPhoneRequest" } } } },
      "Target": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TargetRequest" } } } },
      "TransferReadiness": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransferReadinessRequest" } } } },
      "NobilityReadiness": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NobilityReadinessRequest" } } } },
      "NobilityPurchaseReadiness": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NobilityPurchaseReadinessRequest" } } } },
      "AccountHistory": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountHistoryRequest" } } } },
      "DiamondRecharge": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiamondRechargeRequest" } } } },
      "CrystalRecharge": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CrystalRechargeRequest" } } } },
      "NobilityPreview": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NobilityPreviewRequest" } } } },
      "NobilityRecharge": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NobilityRechargeRequest" } } } },
      "Reconcile": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReconcileRequest" } } } },
      "V2SendOtp": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/V2SendOtpRequest" } } } },
      "V2VerifyOtp": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/V2VerifyOtpRequest" } } } },
      "V2Target": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/V2TargetRequest" } } } },
      "V2Amount": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/V2AmountRequest" } } } },
      "V2AmountTarget": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/V2AmountTargetRequest" } } } },
      "V2Nobility": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/V2NobilityRequest" } } } },
      "V2History": { "required": false, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
      "V2Reconcile": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/V2ReconcileRequest" } } } }
    },
    "responses": {
      "Health": { "description": "Process is live", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } },
      "Ready": { "description": "Local readiness only; never calls Hago", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadyResponse" } } } },
      "Success": { "description": "Sanitized successful response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } } },
      "Error": { "description": "Sanitized error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "SessionValidation": { "description": "Sanitized session state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionValidationResponse" } } } },
      "TransferReadiness": { "description": "Sanitized transfer readiness", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransferReadinessResponse" } } } },
      "WalletBalance": { "description": "Normalized supported balances only", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WalletBalanceResponse" } } } },
      "AccountHistory": { "description": "Read-only history, not a settlement ledger", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountHistoryResponse" } } } },
      "Transaction": { "description": "Sanitized local transaction state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionResponse" } } } },
      "TransactionList": { "description": "Sanitized transaction list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionListResponse" } } } },
      "Preview": { "description": "Local structure metadata only", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PreviewResponse" } } } },
