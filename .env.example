PORT=3000
# Bind the adapter to loopback behind the reverse proxy unless a deliberate deployment override is required.
HOST=127.0.0.1
MONGO_URI=<mongodb-connection-string>
INTERNAL_API_KEY=<long-random-server-to-server-secret>
# Enables V2 tenant-scoped Connection routes authenticated only with
# x-client-api-key. When true, both values below are required.
MULTI_CLIENT_AUTH_ENABLED=false
# Generate independently, for example: openssl rand -base64 32
CLIENT_API_KEY_PEPPER=<base64-encoded-32-byte-client-key-pepper>
# Separate from HAGO_SESSION_ENCRYPTION_KEY; protects future V2 challenge PII.
CLIENT_DATA_ENCRYPTION_KEY=<base64-encoded-32-byte-client-data-key>
# Base64-encoded 32-byte AES-256-GCM key; generate and store in a secret manager.
HAGO_SESSION_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
HAGO_REQUEST_TIMEOUT_MS=15000
HAGO_TURNOVER_BASE_URL=https://db-turnover.ihago.net
# Required for turnover headers unless stored per account during OTP verification.
HAGO_COUNTRY=<two-letter-country-code>
HAGO_LANGUAGE=en
HAGO_MUTATIONS_ENABLED=false
# Together with HAGO_MUTATIONS_ENABLED, both values below are required before a Diamond/Crystal controlled sender can run.
# Keep false for normal operation. Controlled mode fails startup unless the ceiling is set.
HAGO_CONTROLLED_MUTATION_MODE=false
# Required only when HAGO_CONTROLLED_MUTATION_MODE=true; set outside source control.
HAGO_CONTROLLED_MUTATION_MAX_AMOUNT=<authorized-controlled-test-ceiling>
# Nobility is independently disabled by default. Set true only when the
# operator has enabled normal production Nobility purchases.
HAGO_NOBILITY_ENABLED=false
# Optional: when unset, Swagger is enabled outside production and disabled in
# production. Set true to explicitly expose /docs and /openapi.json.
SWAGGER_ENABLED=
